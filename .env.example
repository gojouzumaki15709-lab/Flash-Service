# Copie ce fichier en .env.local pour le développement local
# Sur Vercel, ces mêmes variables se mettent dans Project Settings > Environment Variables

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé secrète pour signer les sessions (génère une chaîne aléatoire longue)
SESSION_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# URL publique du site, utilisée pour construire les liens de retour Wave
# (success_url / error_url). Sur Vercel : https://ton-lien.vercel.app
NEXT_PUBLIC_SITE_URL=https://flash-service.vercel.app

# Clé de chiffrement des secrets sensibles stockés en base (clé API Wave,
# webhook_secret). 32 octets, encodée en hex (64 caractères).
# Génère-la avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATTENTION : si tu perds/changes cette clé après coup, les secrets déjà
# chiffrés en base deviennent illisibles (il faudra les ressaisir via
# l'admin). Garde-la précieusement, hors du dépôt Git.
ENCRYPTION_KEY=change-moi-avec-64-caracteres-hexadecimaux
